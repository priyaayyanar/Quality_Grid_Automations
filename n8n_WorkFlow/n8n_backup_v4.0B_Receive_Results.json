    {"parameters": {"jsCode": "const original = $('Split Out Results').item.json;\nconst parsed = $json.output || {};\n\nlet status = parsed.status;\nlet confidence = Number(parsed.confidence) || 0;\n\n// The LLM sometimes returns confidence as a 0-1 decimal (e.g. 0.9) instead\n// of 0-100. Normalize so the downstream threshold check is reliable either way.\nif (confidence <= 1) {\n  confidence = confidence * 100;\n}\n\n// Safety net: don't trust a low-confidence Pass/Fail, downgrade it\nif ((status === \"Pass\" || status === \"Fail\") && confidence < 70) {\n  status = \"Needs Review\";\n}\n\nreturn {\n  json: {\n    ...original,\n    \"Execution Status\": status,\n    \"Confidence Score\": confidence,\n    \"Comments\": parsed.reasoning || \"\"\n  }\n};", "id": "ec9a6ae4-57f9-4bbe-97c3-ea98e0d56659", "name": "Apply Confidence Safety Net", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [304, -160]},
