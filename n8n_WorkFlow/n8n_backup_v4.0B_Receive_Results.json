    {"parameters": {"promptType": "define", "text": "=Test Case ID: {{ $json[\"Test Case ID\"] }}\nExpected Result: {{ $json[\"Expected Result\"] }}\nActual Result: {{ $json[\"Actual Result\"] }}", "hasOutputParser": true, "messages": {"messageValues": [{"message": "You are a QA test result validator. Compare the Expected Result to the Actual Result captured during test execution. Use Pass only if the Actual Result clearly satisfies the Expected Result. Use Fail only if the Actual Result clearly contradicts or fails to satisfy the Expected Result. Use Needs Review if the Actual Result is ambiguous, incomplete, or does not contain enough information to judge confidently."}]}, "batching": {}}, "id": "747e61ce-11fa-4f12-85cf-46dcfc56ca8c", "name": "LLM Comparison - OpenRouter", "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.9, "position": [-80, -160], "notes": "Swapped from a raw HTTP Request + regex/JSON.parse Code node to n8n's native Basic LLM Chain, wired to the OpenRouter Chat Model + Structured Output Parser subnodes below. Same free-tier model (openai/gpt-oss-20b:free) as before."},
